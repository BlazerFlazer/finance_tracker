# Copy this file to .env and fill in what you need. Every value below has a safe development default
# baked into server/src/config.ts — you only need this file at all once you leave the defaults behind
# (e.g. to send real email, enable AI features, or deploy to production).

# ---------------------------------------------------------------------------------------------- core
NODE_ENV=development
PORT=3001
HOST=127.0.0.1
# Public origin of the app (used for e-mail links and the CSRF Origin check).
APP_URL=http://localhost:5173

# ------------------------------------------------------------------------------------------- database
# Leave unset for local development: FinTrack runs on an embedded PostgreSQL (PGlite) stored under ./data/pg.
# Set this to use a real PostgreSQL instance instead (required in production).
# DATABASE_URL=postgres://user:password@localhost:5432/fintrack
# DATABASE_SSL=false

# ------------------------------------------------------------------------------------------- security
# 32 random bytes, base64-encoded (`openssl rand -base64 32`). Required in production; auto-generated
# and cached in ./data/.dev-key for local development if left unset.
# APP_ENCRYPTION_KEY=
# Forces the session cookie's Secure flag. Defaults to true in production, false otherwise.
# COOKIE_SECURE=true
# Set to a number of hops, or "true", when running behind a reverse proxy (nginx, a load balancer, …).
# TRUST_PROXY=1
# Require an administrator's account to have 2FA enabled before the admin API/UI can be used.
# Defaults to true in production, false otherwise.
# ADMIN_REQUIRE_2FA=true
RATE_LIMIT_DISABLED=false

# ---------------------------------------------------------------------------------------------- email
# smtp: send real email. outbox: store "sent" email in the mail_outbox table, readable at
#   GET /api/dev/mailbox (the default outside production — makes verify/reset emails testable with zero setup).
# log: print to the server log only (used by the automated test suite).
# MAIL_TRANSPORT=outbox
MAIL_FROM="FinTrack <no-reply@fintrack.local>"
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# ------------------------------------------------------------------------------------------ uploads
UPLOAD_DIR=./data/uploads

# ------------------------------------------------------------------------------------------------ AI
# Optional. Without a key, AI Insights and the AI Assistant still work fully using their deterministic,
# rule-based engine — this only adds an LLM-phrased layer on top, and only for users who opt in.
# ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# ------------------------------------------------------------------------------------- web push (optional)
# Generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com

# --------------------------------------------------------------------------------------------- demo
DEMO_ENABLED=true
DEMO_TTL_HOURS=24

# -------------------------------------------------------------------------------------------- admin
# Optional: lets `npm run admin:create` run with no flags.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_USERNAME=
# SEED_ADMIN_PASSWORD=

LOG_LEVEL=info
