{
  "name": "fintrack",
  "version": "1.0.0",
  "private": true,
  "description": "FinTrack — personal finance management platform. Know your money. Control your future.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "cross-env PORT=3001 tsx watch --clear-screen=false server/src/index.ts",
    "dev:web": "vite web",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build web",
    "build:server": "tsup",
    "start": "node server/dist/index.js",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx server/src/cli/db.ts migrate",
    "db:reset": "tsx server/src/cli/db.ts reset",
    "db:status": "tsx server/src/cli/db.ts status",
    "admin:create": "tsx server/src/cli/create-admin.ts",
    "docs:api": "tsx scripts/gen-api-docs.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@electric-sql/pglite": "^0.5.8",
    "@fastify/compress": "^9.2.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.2",
    "@fastify/static": "^10.1.5",
    "@node-rs/argon2": "^2.2.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/rus": "^1.0.0",
    "@tesseract.js-data/uzb": "^1.0.0",
    "dejavu-fonts-ttf": "^2.37.3",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "geoip-country": "^5.0.202609260156",
    "nodemailer": "^10.0.12",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "tesseract.js-core": "^6.1.2",
    "web-push": "^3.6.7",
    "write-excel-file": "^4.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/react-query": "^5.104.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/papaparse": "^5.3.16",
    "@types/pdfkit": "^0.17.0",
    "@types/pg": "^8.15.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "lucide-react": "^1.48.0",
    "papaparse": "^5.7.0",
    "pino-pretty": "^13.1.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "recharts": "^3.10.1",
    "tesseract.js": "^7.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
