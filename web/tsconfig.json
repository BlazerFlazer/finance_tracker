{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "noEmit": true,
    "baseUrl": "..",
    "paths": {
      "@shared/*": ["shared/src/*"],
      "@/*": ["web/src/*"]
    }
  },
  "include": ["src", "vite.config.ts", "../shared/src"]
}
